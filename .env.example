# Endereço do site (opcional). Sem nada, vale psiangelo.github.io/RaposaAnalitica.
# Para um domínio próprio sem subpasta: NEXT_PUBLIC_SITE_ORIGIN=https://raposaanalitica.com.br
# e NEXT_PUBLIC_BASE_PATH= (vazio).
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_BASE_PATH=/RaposaAnalitica

# Repositório onde o painel publica (dono/nome).
NEXT_PUBLIC_GITHUB_REPO=Psiangelo/RaposaAnalitica

# Plausible (opcional, sem cookies). Vazio = desligado.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
